{
  "name": "edge-links",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:export": "tsx scripts/export-openapi.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/swagger": "9.7.0",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.15",
    "eslint": "9.39.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
